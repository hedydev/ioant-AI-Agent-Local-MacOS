{
  "name": "ioant-ai-agent-local-macos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only OpenClaw browser auditing with local Ollama",
  "scripts": {
    "test": "node --test",
    "audit": "node src/audit.mjs --once",
    "watch": "node src/audit.mjs --watch",
    "env:scan": "node src/environment.mjs scan",
    "env:save": "node src/environment.mjs save",
    "env:check": "node src/environment.mjs check",
    "console": "bash scripts/tunnel-console-service.sh start",
    "console:status": "bash scripts/tunnel-console-service.sh status",
    "console:stop": "bash scripts/tunnel-console-service.sh stop"
  }
}
